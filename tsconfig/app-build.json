{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./vue-library.json"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.spec.*", "**/*.test.*"]
}
