{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig/vue-library.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    // Match the journeys vitest config's runtime resolution (vite = bundler):
    // headless, @upmind-automation/test-fixtures and vitest all ship exports
    // maps that node10 resolution can't read.
    "moduleResolution": "bundler",
    // The barrel graph imports a handful of type-only symbols in value position;
    // that is fine for a noEmit gate, so don't fail on verbatim import syntax.
    "verbatimModuleSyntax": false,
    // headless source (system-places) is in this program, so its google.maps
    // types must be too — declared as this package's own devDependency.
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "types": ["node", "google.maps"],
    "paths": {
      // Mirror tests/journeys/vitest.journeys.config.ts: the barrels resolve to
      // their workspace SOURCE (not built dist), so the journey type-checks
      // against the exact graph it runs against.
      "@upmind-automation/headless": ["../../packages/headless/src/index.ts"],
      "@upmind-automation/types": ["../../packages/types/src/index.ts"],
      "@upmind-automation/i18n": ["../../packages/i18n/src/index.ts"],
      "@upmind-automation/scenario-harness": [
        "../../packages/scenario-harness/src/index.ts"
      ],
      "@upmind-automation/test-fixtures": ["../fixtures/index.ts"],
      "@upmind-automation/test-fixtures/*": ["../fixtures/*"],
      // psl ships its types outside its package.json "exports", so exports-aware
      // resolution can't find them; point at the shipped declarations directly.
      "psl": ["./node_modules/psl/types/index.d.ts"]
    }
  },
  // Scoped to the barrel-importing integration surface. The .spec.ts Playwright
  // slices reuse the shared tests/Playwright support library and root
  // playwright.config; those are compiled by the Playwright toolchain, not this
  // gate. vite-env.d.ts pulls vite/client (import.meta.env) into the program.
  "include": [
    "storefront/**/*.int.test.ts",
    "storefront/**/journey.ts",
    "storefront/**/setup.ts",
    "scenario-harness/**/*.int.test.ts",
    "scenario-harness/**/*.ts",
    "vite-env.d.ts"
  ],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
