-  // The key must be present to opt out, or useConfig fetches the basket on every auth page.
-  basket: undefined,
   context: UIContext.AUTH,
   provide: true
 });
diff --git a/packages/modules-auth/src/Register.vue b/packages/modules-auth/src/Register.vue
