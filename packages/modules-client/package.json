{
  "name": "@upmind-automation/client",
  "version": "0.20.18",
  "description": "Upmind client domain package — addresses · emails · companies · phones.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles.css"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "reset": "rm -rf {node_modules,dist,*.tsbuildinfo}",
    "build": "vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "node ../../etc/ci/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../etc/ci/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@jsonforms/core": "^3.6.0",
    "@jsonforms/vue": "^3.6.0",
    "@upmind/ui": "workspace:*",
    "@upmind-automation/foundation": "workspace:*",
    "@upmind-automation/headless": "workspace:*",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vue-i18n": "^11.1.1"
  }
}
