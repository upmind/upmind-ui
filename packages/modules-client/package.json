{
  "name": "@upmind-automation/client",
  "version": "0.20.18",
  "description": "Upmind client domain package — addresses · emails · companies · phones.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "reset": "rm -rf {node_modules,dist,*.tsbuildinfo}",
    "build": "vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc -p tsconfig.build.json --noEmit",
    "lint": "node ../../.claude/scripts/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../.claude/scripts/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@upmind/ui": "workspace:*",
    "@upmind-automation/headless": "workspace:*",
    "@upmind-automation/foundation": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}
