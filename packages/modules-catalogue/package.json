{
  "name": "@upmind-automation/catalogue",
  "version": "0.20.17",
  "description": "Upmind catalogue domain package — browse: catalogue · categories.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/feature.ts",
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "reset": "rm -rf {node_modules,dist,*.tsbuildinfo}",
    "type-check": "vue-tsc -p tsconfig.build.json --noEmit",
    "lint": "node ../../.claude/scripts/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../.claude/scripts/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@upmind/ui": "workspace:*",
    "@upmind-automation/headless": "workspace:*",
    "@upmind-automation/foundation": "workspace:*",
    "@upmind-automation/product": "workspace:*",
    "@upmind-automation/recommendations": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}
