# Negative control — the product hero ignores the direction the layout sets on
# the product-details slot. A layout that stacks the hero still draws it side
# by side.
#
# Intended RED:
#   packages/modules-product/src/__tests__/configure-slots.int.test.ts
#     "draws the hero horizontally by default, and vertically with no image where the layout says"

diff --git a/packages/modules-product/src/components/Configure.vue b/packages/modules-product/src/components/Configure.vue
--- a/packages/modules-product/src/components/Configure.vue
+++ b/packages/modules-product/src/components/Configure.vue
@@ -19,7 +19,7 @@
         <ProductHero
           v-if="productMeta?.isAvailable && product?.productDetails"
           :product-details="product.productDetails"
-          :direction="direction"
+          :direction="PRODUCT_HERO_DIRECTION.HORIZONTAL"
           :image="heroImage && configMeta.ui.productImages.isVisible"
           :meta="configMeta"
         >
