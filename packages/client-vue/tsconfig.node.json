{
  "extends": "@tsconfig/node18/tsconfig.json", // Extend Node's base config directly
  "compilerOptions": {
    "composite": true,
    "module": "commonjs", // or "nodenext"
    "moduleResolution": "node", // or "nodenext"
    "outDir": "dist/node",
    "types": ["node"]
  },
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*"
  ]
}
