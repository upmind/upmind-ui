{
  // This tsconfig is for development. Allowing *.story.vue, and __test__/*.vue to have types support
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "lib": ["esnext", "dom"],
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["src/*"],
      "@upmind-automation/types": ["../types/dist/types"],
      "@upmind-automation/headless": ["../headless/dist/types"],
      "@upmind-automation/headless-vue": ["../headless-vue/dist/types"],
      "@upmind-automation/upmind-ui": ["../ui/dist/types"]
    },
    "resolveJsonModule": true,
    "types": ["node", "jsdom"],
    "strict": true,
    "declaration": false,
    "declarationDir": "./dist/types", // Correct declaration directory
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "references": [
    { "path": "../types" },
    { "path": "../headless" },
    { "path": "../headless-vue" },
    { "path": "../ui" }
  ]
}
