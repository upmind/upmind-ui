@@ -79,7 +79,9 @@ function onPick(member?: unknown): void {
   const picked = find(items.value, item => item.member === member);
   handleChange(
     control.value.path,
-    picked?.key ? { [picked.key]: picked.value } : {}
+    picked?.key
+      ? { ...(control.value.data ?? {}), [picked.key]: picked.value }
+      : {}
   );
 }
