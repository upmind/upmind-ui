# replacing it, so the Subscriptions narrowing survives the One-time pick.
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>
diff --git a/packages/client-vue/src/components/form/renderers/FilterExclusiveToggleGroupRenderer.vue b/packages/client-vue/src/components/form/renderers/FilterExclusiveToggleGroupRenderer.vue
index 00f39b58a..bc56a563a 100644
