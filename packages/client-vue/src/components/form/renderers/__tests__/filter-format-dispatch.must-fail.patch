index c677d83b9..086933e91 100644
--- a/packages/client-vue/src/components/form/renderers/FilterToggleGroupRenderer.vue
+++ b/packages/client-vue/src/components/form/renderers/FilterToggleGroupRenderer.vue
@@ -101,7 +101,7 @@ export const tester = {
   controlType: and(
     isBooleanControl,
     isEnumControl,
-    optionIs("format", "toggle-group")
+    optionIs("format", "button-group")
   )
 };
