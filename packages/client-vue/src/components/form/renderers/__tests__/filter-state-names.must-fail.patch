Negative control for the label-less treatment's STATE NAMES (P1-R3).

Ignores the uischema's own `states` keys, so the label-less toggle group falls
back to the schema's generic Yes/No titles — a control with no label and no
state name, which says nothing about the column it filters. Any assertion that
reads the rendered position labels goes red; one that counts positions stays
green.

Apply from the repo root: `git apply <this file>`; revert with `git apply -R`.

diff --git a/packages/client-vue/src/components/form/renderers/FilterRenderer.vue b/packages/client-vue/src/components/form/renderers/FilterRenderer.vue
--- a/packages/client-vue/src/components/form/renderers/FilterRenderer.vue
+++ b/packages/client-vue/src/components/form/renderers/FilterRenderer.vue
@@ -297,8 +297,7 @@
  */
 const stateItems = computed<ToggleGroupItem[]>(() =>
   map(options.value, option => {
-    const key = get(stateKeys.value, option.value);
-    return { value: option.value, label: key ? translate(key) : option.title };
+    return { value: option.value, label: option.title };
   })
 );
 
