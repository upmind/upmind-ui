+++ b/packages/client-vue/src/components/form/engine/renderers/controls/LookupRenderer.vue
@@ -91,7 +91,6 @@ const items = computed<LookupItem[]>(() =>
     ? (lookup!.items.value ?? [])
     : (control.value?.options as LookupItem[]) ||
       (appliedOptions.value?.items as LookupItem[]) ||
-      lookupOptions?.options ||
       []
 );

