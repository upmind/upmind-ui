Negative control for LookupRenderer.test.ts (B4 search forwarding).

Drops the `debouncedSearch(term)` call from the combobox's `@input` handler, so a typed
term never reaches `useLookup().search`. The B4 assertion that `handle.search` is called
with the typed term goes red.

diff --git a/packages/client-vue/src/components/form/engine/renderers/controls/LookupRenderer.vue b/packages/client-vue/src/components/form/engine/renderers/controls/LookupRenderer.vue
index 44f2e458d..21f4f3e1b 100644
--- a/packages/client-vue/src/components/form/engine/renderers/controls/LookupRenderer.vue
+++ b/packages/client-vue/src/components/form/engine/renderers/controls/LookupRenderer.vue
@@ -117,7 +117,7 @@ const debouncedSearch = debounce(
 
 function onSearchInput(event: Event) {
   if (!isAsync) return;
-  debouncedSearch((event.target as HTMLInputElement).value);
+  void event;
 }
 
 onBeforeUnmount(() => debouncedSearch.cancel());
