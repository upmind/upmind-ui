{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig/vue-library.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@upmind-automation/auth": ["../modules-auth/src/index.ts"],
      "@upmind-automation/client": ["../modules-client/src/index.ts"],
      "@upmind-automation/foundation": ["../modules-foundation/src/index.ts"],
      "@upmind-automation/invoice": ["../modules-invoice/src/index.ts"],
      "@upmind-automation/payment": ["../modules-payment/src/index.ts"],
      "@upmind-automation/product": ["../modules-product/src/index.ts"],
      "@upmind-automation/recommendations": [
        "../modules-recommendations/src/index.ts"
      ],
      "@upmind/ui": ["../../design-system/packages/ui/src/index.ts"],
      "@upmind/tokens": ["../../design-system/packages/tokens/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.spec.*",
    "**/*.test.*"
  ],
  "references": [
    { "path": "../types/tsconfig.build.json" },
    { "path": "../headless/tsconfig.build.json" },
    { "path": "../modules-foundation/tsconfig.build.json" },
    { "path": "../modules-auth/tsconfig.build.json" },
    { "path": "../modules-client/tsconfig.build.json" },
    { "path": "../modules-invoice/tsconfig.build.json" },
    { "path": "../modules-payment/tsconfig.build.json" },
    { "path": "../modules-product/tsconfig.build.json" },
    { "path": "../modules-recommendations/tsconfig.build.json" },
    { "path": "../../design-system/packages/ui/tsconfig.build.json" },
    { "path": "../../design-system/packages/tokens/tsconfig.build.json" }
  ]
}
