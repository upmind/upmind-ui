{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig/vue-library.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@upmind-automation/types": ["../types/src/index.ts"],
      "@upmind-automation/i18n": ["../i18n/src/index.ts"],
      "@upmind-automation/i18n/*": ["../i18n/src/*"],
      "@upmind-automation/headless": ["../headless/src/index.ts"],
      "@upmind-automation/icons": ["../icons/src/index.ts"],
      "@upmind-automation/upmind-ui": ["../ui/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../types/src/**/*",
    "../i18n/src/**/*",
    "../headless/src/**/*",
    "../icons/src/**/*",
    "../ui/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "**/*.test.*"]
}
