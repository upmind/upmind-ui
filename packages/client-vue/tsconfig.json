{
  // This tsconfig is for development. Allowing *.story.vue, and __test__/*.vue to have types support
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "emitDeclarationOnly": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@/*": ["src/*"],
      "@upmind-automation/headless": ["../headless/src/index.ts"],
      "@upmind-automation/upmind-ui": ["../ui/src/index.ts"]
    },
    "resolveJsonModule": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "types": ["jsdom", "vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "src/**/*.test.ts"],
  "references": [
    { "path": "../types" },
    { "path": "../headless" },
    { "path": "../ui" }
  ]
}
