{
  "name": "@upmind-automation/foundation",
  "version": "0.20.18",
  "description": "Upmind foundation domain package — brand · app-wiring.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "reset": "rm -rf {node_modules,dist,*.tsbuildinfo}",
    "type-check": "vue-tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "node ../../.claude/scripts/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../.claude/scripts/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@upmind/ui": "workspace:*",
    "@upmind-automation/headless": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vue-router": "^4.5.0"
  }
}
