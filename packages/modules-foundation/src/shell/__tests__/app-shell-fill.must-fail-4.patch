# Negative control — cart-nuxt's basket hand-rolls its pick as a bare record
# lookup instead of declaring it with resolveTemplate, so a brand with no
# template, an empty one, or a stale one gets no basket page.
#
# Intended RED:
#   packages/modules-foundation/src/shell/__tests__/app-shell-fill.test.ts
#     "finds cart-nuxt's picks"
#     "cart-nuxt hands every module's record and pick to a page"
#     "cart-nuxt's pages take each record from its own module"
#     "cart-nuxt's basket hands its pages a pick"
#     "cart-nuxt's basket falls back to a template it draws"
#     "the two apps against each other > falls back to the same template in both"

diff --git a/apps/cart-nuxt/app/shell/modules/basket/shell.ts b/apps/cart-nuxt/app/shell/modules/basket/shell.ts
--- a/apps/cart-nuxt/app/shell/modules/basket/shell.ts
+++ b/apps/cart-nuxt/app/shell/modules/basket/shell.ts
@@ -21,7 +21,5 @@
   [BASKET_TEMPLATE.INSET]: BasketInsetTemplate
 };
 
-export const basketTemplate = resolveTemplate(
-  BASKET_TEMPLATES,
-  BASKET_TEMPLATE.TWO_COLUMN_LTR
-);
+export const basketTemplate = (template: string) =>
+  BASKET_TEMPLATES[template as BASKET_TEMPLATE];
