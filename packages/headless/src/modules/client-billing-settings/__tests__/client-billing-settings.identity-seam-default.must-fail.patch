# client-billing-settings.identity-seam-default.must-fail.patch
#
# Targets: AC-1 (the SELF arm of the identity seam) — with no .for('client', id)
# context, the read must fall back to the active session's OWN client. The self
# fallback lives in resolveClientId(scopeContext?)'s `: activeUser.value?.id`
# arm, reached when the scope carries no CLIENT context (ADR-001).
#
# Authored by: developer seat (agent-seat-separation.companion.md — the seat
# that knows the exact line it changed authors the mutant; the prover applies
# it blind, confirms RED, then reverts — never reading src to construct it).
#
# Mutates: client-billing-settings.services.ts resolveClientId — drops the
# `: activeUser.value?.id` fallback so the SELF case resolves `undefined`,
# leaving the session's own read unaddressable (isAddressable gates it off).
#
# Expected RED: client-billing-settings.read.int.test.ts —
# "AC1 reads the five consolidation values off the addressed client record" —
# the session's own read never resolves an id, so no values seed. AC-1 is the
# canonical self-arm assertion; because every spec in read.int.test.ts seeds a
# self session, breaking the fallback reddens the whole file — that breadth is
# the shared seam, not the mutant.
#
# Apply / verify / revert:
#   git apply <this file>
#   pnpm --filter @upmind-automation/headless test client-billing-settings.read.int   # must go RED
#   git apply -R <this file>
#
diff --git a/packages/headless/src/modules/client-billing-settings/client-billing-settings.services.ts b/packages/headless/src/modules/client-billing-settings/client-billing-settings.services.ts
index 62a6172a3..64495dc32 100644
--- a/packages/headless/src/modules/client-billing-settings/client-billing-settings.services.ts
+++ b/packages/headless/src/modules/client-billing-settings/client-billing-settings.services.ts
@@ -128,7 +128,7 @@ function resolveClientId(scopeContext?: ScopeContext) {
     scopeContext?.type === ClientBillingSettingsContextTypes.CLIENT &&
     scopeContext.id
       ? scopeContext.id
-      : activeUser.value?.id
+      : undefined
   );
 }
 
