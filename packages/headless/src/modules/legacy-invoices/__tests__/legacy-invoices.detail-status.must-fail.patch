# Must-fail mutant for legacy-invoices.single-read.int.test.ts's AC-7 detail
# specification (T48). Paired describe: "legacy-invoices single read — the
# preserved bill and its five conditions (AC-7)". Test-review blocker (b),
# the `isPaid` / `isOverdue` half.
#
# Mutates `useLegacyInvoice.meta.ts`'s shared `statusCode` — misspells the
# lodash `get()` PATH string from `content.status.code` to
# `content.statusx.code` (design.md §8.13's own instruction: "The must-fail
# patch of the detail specification must bite a PATH assertion of section
# 8.13, never a condition assertion" — this is a PATH mutation, not a
# condition-logic mutation).
#
# ONE mutation point covers BOTH `isPaid` and `isOverdue` — design.md §8.13
# states it plainly: "paid" and "overdue" both read `content.status`, "the
# same comparison" [o20]. The module has no second, independently-misspellable
# path for either condition; they share `statusCode`. This is a structural
# finding, not a shortcut: a genuinely separate per-condition path does not
# exist in the shipped code, so ONE patch stands in for both, with both
# named as its paired target.
#
# **Reddens — confirmed against the TWO TRUE cases added over the derived
# get-import-invoice-data-id-case-paid and -case-overdue captures**
# (legacy-invoices.single-read.int.test.ts's "@AC-7 isPaid reads true..." and
# "@AC-7 isOverdue reads true..."): with this patch applied, both
# specifications fail together — the shared `statusCode` read is the one
# mutation point named above — while the remaining eight tests in the file
# stay green. Re-verified applied-and-reverted.
#
# Declared collateral: NONE (verified — full headless integration and unit
# suites stay green with this patch applied; it touches no other
# assertion).
#
# Apply from the repo root: `git apply <this file>`; revert with `git apply -R`.
--- a/packages/headless/src/modules/legacy-invoices/useLegacyInvoice.meta.ts
+++ b/packages/headless/src/modules/legacy-invoices/useLegacyInvoice.meta.ts
@@ -43,7 +43,7 @@
 
   /** design.md 8.13 — paid/overdue read `content.status`, the shared status vocabulary (`oracle: legacyInvoiceProvider.vue:67-71` isPaid, `:72-76` isOverdue). */
   const statusCode = computed(() =>
-    get(query.data.value, "content.status.code")
+    get(query.data.value, "content.statusx.code")
   );
 
   const isPaid = computed(() => statusCode.value === InvoiceStatus.PAID);
