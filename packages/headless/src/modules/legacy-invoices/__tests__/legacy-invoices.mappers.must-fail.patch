# Apply from the repo root: `git apply <this file>`; revert with `git apply -R`.
--- a/packages/headless/src/modules/legacy-invoices/legacy-invoices.mappers.ts
+++ b/packages/headless/src/modules/legacy-invoices/legacy-invoices.mappers.ts
