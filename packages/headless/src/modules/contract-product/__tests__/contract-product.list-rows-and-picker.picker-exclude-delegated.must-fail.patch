# Negative-control mutant — the picker honours the show-delegated preference (W1)
#
# Scenario it must flip: a picker spec for a client whose preference shows
#   delegated products (`excludeDelegatedProducts: false`, holding delegated
#   products) that asserts the picker's `GET contracts_products` carries
#   `exclude_delegated=0` — the same value the list request sends.
# Mutation: the picker hardcodes `exclude_delegated=1` whatever the
#   preference.
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>
diff --git a/packages/headless/src/modules/contract-product/contract-product.services.ts b/packages/headless/src/modules/contract-product/contract-product.services.ts
--- a/packages/headless/src/modules/contract-product/contract-product.services.ts
+++ b/packages/headless/src/modules/contract-product/contract-product.services.ts
@@ -343,7 +343,7 @@ function loadContractProductPickerLookup(
           reject(new NotAuthenticatedError());
           return;
         }
-        url.searchParams.set("exclude_delegated", `${excludeDelegated.value}`);
+        url.searchParams.set("exclude_delegated", "1");
         resolve(true);
       }),
     select: mapContractProductPickerItems,
