# Negative-control mutant — contract-product remembered delegated preference (AC-18)
#
# Scenario it must flip: contract-product.feature >
#   "My choice about delegated products is remembered"
# Test that goes red: the AC-18 scenario has no colocated test yet — the
#   prover authors it against this mutant. The load-bearing assertion: with a
#   stored `excludeDelegatedProducts: false` preference and a session that HAS
#   delegated products, the observed `GET contracts_products` URL carries
#   `exclude_delegated=0` (the remembered "show them" choice) — under the
#   mutant it carries `exclude_delegated=1`, and the delegated rows vanish
#   even though the client asked once to see them.
# Mutation: `resolveExcludeDelegated` drops the `preference === false` arm, so
#   a remembered "show delegated" choice falls through to the no-preference
#   default and is forgotten.
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>
diff --git a/packages/headless/src/modules/contract-product/contract-product.utils.ts b/packages/headless/src/modules/contract-product/contract-product.utils.ts
index 34fab8669..d3dcc2a75 100644
--- a/packages/headless/src/modules/contract-product/contract-product.utils.ts
+++ b/packages/headless/src/modules/contract-product/contract-product.utils.ts
@@ -110,7 +110,6 @@ export function resolveExcludeDelegated(
 ): 0 | 1 {
   if (scopeContext?.type === ContractProductsContextTypes.DELEGATED) return 0;
   if (preference === true) return 1;
-  if (preference === false) return 0;
   return hasDelegatedProducts ? 1 : 0;
 }
 
