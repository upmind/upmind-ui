# Negative-control mutant — the cancellation form opens only where the product has options (AC-11)
#
# Scenario it must flip: contract-product.feature >
#   "I am told whether the cancellation form is offered before I open it — a subscription already set to expire"
# Test that goes red: contract-product.replay.int.test.ts > that scenario —
#   "Then what I am told matches whether the cancellation form opens when I ask for it" —
#   the open lands `isCancellationOpen: true` on a product with no options left.
# Mutation: `hasCancellationOptions` (the open guard) drops the
#   `!isEmpty(cancellationOptions(...))` check, so the open admits a product
#   that has no cancellation options.
# Collateral: the other AC-11 "not offered" rows on an available node (booked for a future
#   date, request already pending, live one-off purchase).
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>
diff --git a/packages/headless/src/modules/contract-product/contract-product.machine.ts b/packages/headless/src/modules/contract-product/contract-product.machine.ts
--- a/packages/headless/src/modules/contract-product/contract-product.machine.ts
+++ b/packages/headless/src/modules/contract-product/contract-product.machine.ts
@@ -902,7 +902,7 @@
         stateMatches(migration?.ref, ["available"]),
 
       hasCancellationOptions: ({ contractProduct }: ContractProductContext) =>
-        !!contractProduct && !isEmpty(cancellationOptions(contractProduct)),
+        !!contractProduct,
 
       isSubscription: ({ contractProduct }: ContractProductContext) =>
         !!contractProduct?.isSubscription,
