@@ -280,7 +280,7 @@ export const contractProductMachine = createMachine(
                           src: "validateCancellation",
                           onDone: { target: "updating" },
                           onError: {
-                            target: "#cancelling.available.error",
+                            target: "updating",
                             actions: ["setError"]
