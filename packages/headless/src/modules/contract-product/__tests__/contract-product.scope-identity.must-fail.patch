#
# Scenario it must flip: contract-product.feature >
#   "The account I act on is the one my scope resolved"
# Test that goes red: contract-product.mutations.int.test.ts >
#   "AC-16 the request is addressed to the product `.for()` resolved, never to any clientId option or an unresolved id"
