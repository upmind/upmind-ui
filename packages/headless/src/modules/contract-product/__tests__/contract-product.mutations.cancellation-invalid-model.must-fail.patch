# Negative-control mutant — the SCHEDULE cancel submit validates the future date before it writes (AC-6, R33/R35)
#
# Naming: the sibling spec `contract-product.mutations.int.test.ts` already owns
#   `contract-product.mutations.validation.must-fail.patch` (the HARD-path
#   control), so this second concern for the same spec takes the
#   `<spec-basename>.<concern>` form:
#   `contract-product.mutations.cancellation-invalid-model.must-fail.patch`.
#
# Scenario it must flip: contract-product.mutations.int.test.ts >
#   "useContractProduct — I ask for one of my products to be cancelled outright
#   (AC-6, R33)" >
#   "AC-6 an invalid model makes NO request and lands a 422 in the form's error
#   region, the form left open (R35)".
#   The test submits a future date one day BEFORE
#   `minFutureCancellationDate` under SCHEDULE_FUTURE and asserts
#   `submitCancellation()` rejects, NO `schedule-cancel` PUT leaves and a 422
#   lands in the form's error region.
# Why the earlier machine mutant survived: an invalid model is caught at
#   `available.checking` (its own `validateCancellation`) before submit, so the
#   `processing.schedulingCancellation.validating` `onError` arm the earlier
#   mutant retargeted was never the arm this scenario travels. The date floor
#   the whole scenario turns on is the schema's `formatMinimum`, which
#   `validateCancellation` enforces on every arm.
# Mutation: the cancellation schema drops `formatMinimum` from
#   `futureCancellationDate`, so the too-early date passes validation, the
#   `schedule-cancel` write fires and `submitCancellation()` resolves — the
#   rejection / no-request / 422 assertions all flip.
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>
diff --git a/packages/headless/src/modules/contract-product/contract-product.schemas.ts b/packages/headless/src/modules/contract-product/contract-product.schemas.ts
--- a/packages/headless/src/modules/contract-product/contract-product.schemas.ts
+++ b/packages/headless/src/modules/contract-product/contract-product.schemas.ts
@@ -464,7 +464,7 @@ export function useCancellationSchema({
         type: "string",
         title: "Cancellation date",
         format: "date",
-        ...(minDate ? { formatMinimum: minDate, default: minDate } : {})
+        ...(minDate ? { default: minDate } : {})
       },
       reason: { type: "string", title: "Reason" },
       ...(!isEmpty(customFields) && {
