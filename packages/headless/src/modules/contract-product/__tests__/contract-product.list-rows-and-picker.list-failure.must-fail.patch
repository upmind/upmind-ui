# Revert with: git apply -R <this file>
diff --git a/packages/headless/src/modules/contract-product/useContractProducts.meta.ts b/packages/headless/src/modules/contract-product/useContractProducts.meta.ts
--- a/packages/headless/src/modules/contract-product/useContractProducts.meta.ts
+++ b/packages/headless/src/modules/contract-product/useContractProducts.meta.ts
@@ -18,9 +18,7 @@ export function createContractProductsMeta(
 ) {
   // Truthiness, not `isEmpty`: a TanStack error is an `Error` instance with no
   // own enumerable keys, which `isEmpty` reports as empty.
-  const hasError = computed(
-    () => !!query.error.value || !!query.criteriaError.value
-  );
+  const hasError = computed(() => !!query.criteriaError.value);
 
   const isEmptyList = computed(() => isEmpty(query.data?.value));
 
