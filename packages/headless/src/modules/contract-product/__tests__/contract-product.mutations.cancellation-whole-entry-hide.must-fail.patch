# Negative-control mutant — a scheduled future cancellation hides the WHOLE cancel entry (B1, AC-11, R33)
#
# Legacy `cProdProvider.vue:252-275` hides the whole cancel entry (isVisible:
#   false) when a future cancellation is already scheduled. `cancellationOptions`
#   models this as an early `[]` return, so no option — not even the soft
#   end-of-term one — is offered for such a product.
# Mutation: drops the `hasScheduledFutureCancellation` whole-entry `return`, so a
#   product with a scheduled future cancellation is once again offered the SOFT
#   end-of-term option (the pre-B1 leak: SOFT never keyed on that fact).
#
# NO EXISTING TEST FLIPS THIS MUTANT. The "cancellation form is hidden where
#   legacy hides it (AC-11, R35)" describe covers only the auto-expire and
#   pending cases; it has no scenario for a product that already carries a
#   scheduled future cancellation. The prover must add one: seed a product whose
#   `contract_request.status.code` is `REQUEST_SCHEDULED_FUTURE_CANCELLATION`,
#   open the cancellation form, and assert the `cancellation` slot is left empty
#   (or its `option.enum` omits SOFT). This patch is the negative control that
#   test must flip.
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>
diff --git a/packages/headless/src/modules/contract-product/contract-product.utils.ts b/packages/headless/src/modules/contract-product/contract-product.utils.ts
index e58e01dfb..1de67c68e 100644
--- a/packages/headless/src/modules/contract-product/contract-product.utils.ts
+++ b/packages/headless/src/modules/contract-product/contract-product.utils.ts
@@ -175,7 +175,6 @@ export function cancellationOptions(
   if (!product.isSubscription) return options;
   if (hasAutoExpireEnabled(product)) return options;
   if (hasHardCancellationRequest(product)) return options;
-  if (product.hasScheduledFutureCancellation) return options;
 
   const isPending = product.contractStatus === ContractStatusCodes.PENDING;
 
