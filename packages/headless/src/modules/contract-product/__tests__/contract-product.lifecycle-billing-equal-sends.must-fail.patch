#   carries, so the current pick is sent.
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>

diff --git a/packages/headless/src/modules/contract-product/useContractProduct.actions.ts b/packages/headless/src/modules/contract-product/useContractProduct.actions.ts
--- a/packages/headless/src/modules/contract-product/useContractProduct.actions.ts
+++ b/packages/headless/src/modules/contract-product/useContractProduct.actions.ts
@@ -333,7 +333,7 @@
     if (isNil(picked)) return false;
     if (
       product &&
-      picked === (product.billingCompanyId ?? product.billingAddressId)
+      picked === `${product.billingCompanyId ?? product.billingAddressId}-`
     ) {
       send({ type: `CANCEL.${ContractProductFormTypes.BILLING_ENTITY}` });
       return product;
