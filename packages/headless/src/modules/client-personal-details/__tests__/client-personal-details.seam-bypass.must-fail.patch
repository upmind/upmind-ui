# client-personal-details.seam-bypass.must-fail.patch
#
# Targets: the custom-field VALUE mapping seam — the read maps each value
# through `mapCustomFieldValue(value, field)` (definition-driven), never a
# naive `String()`. Bypassing the seam renders the literal word "undefined"
# for absent values instead of the mapper's empty shape.
#
# Authored by: developer seat (agent-seat-separation.companion.md — the seat
# that knows the exact line it changed authors the mutant; the prover applies
# it blind, confirms RED, then reverts — never reading src to construct it).
#
# REBASED (one-composable refactor): `mapProfileFields` now projects the edit
# model's code-keyed `customFields` against the definitions, so there is ONE
# custom-field mapping site. Same mutation, new context.
#
# Mutates: client-personal-details.mappers.ts — the one custom-field mapping
# site swaps `mapCustomFieldValue(...)` for `String(...)`, bypassing the seam.
#
# Expected RED: client-personal-details.mappers.test.ts —
# "AC-59 projects a custom field's value exactly as A's own seam
# (mapCustomFieldValues) coerces it — never re-derived locally" — the value must
# ride A's coercion seam, never a local String().
#
# Apply / verify / revert:
#   git apply <this file>
#   pnpm --filter @upmind-automation/headless test client-personal-details.mappers   # must go RED
#   git apply -R <this file>
#
diff --git a/packages/headless/src/modules/client-personal-details/client-personal-details.mappers.ts b/packages/headless/src/modules/client-personal-details/client-personal-details.mappers.ts
--- a/packages/headless/src/modules/client-personal-details/client-personal-details.mappers.ts
+++ b/packages/headless/src/modules/client-personal-details/client-personal-details.mappers.ts
@@ -142,7 +142,7 @@ export function mapProfileFields(
       code: field.code,
       fieldPath: `customFields.${field.code}`,
       title: field.name,
-      value: mapCustomFieldValue(model.customFields?.[field.code], field),
+      value: String(model.customFields?.[field.code]),
       meta: { ...field.meta, isCustomField: true }
     }))
   ];
