# Negative-control mutant — the payment-method form on a cancelled or lapsed contract (AC-8, R13)
#
# Scenario it must flip: contract.feature:380 "I change how my contract is paid
#   for through the payment-method form, whatever its standing", Examples rows
#   cancelled (feature:388) and lapsed (feature:389).
# Tests that go red: contract.payment-method-standing.int.test.ts:190
#   "submits a different stored card through the form on a cancelled contract"
#   and :195 "submits a different stored card through the form on a lapsed
#   contract" (the form never opens, so
#   `expect(manager.useMeta().isPaymentMethodOpen.value).toBe(true)` flips).
# Mutation: the `unavailable.changingPaymentMethod.idle` node drops its
#   `PAYMENT_METHOD` transition — the pre-R13 read-only contract, where a
#   cancelled or lapsed contract refuses the form like fraud does.
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>
diff --git a/packages/headless/src/modules/contract/contract.machine.ts b/packages/headless/src/modules/contract/contract.machine.ts
index 3e102716a..3506658a4 100644
--- a/packages/headless/src/modules/contract/contract.machine.ts
+++ b/packages/headless/src/modules/contract/contract.machine.ts
@@ -204,13 +204,6 @@ export default createMachine(
             states: {
               idle: {
                 on: {
-                  // R13: a cancelled or lapsed contract may still change its
-                  // payment method; `fraud` alone is refused.
-                  PAYMENT_METHOD: {
-                    target: "available",
-                    actions: "setPaymentMethodSchemas",
-                    cond: "canChangePaymentMethod"
-                  }
                 }
               },
               available: {
