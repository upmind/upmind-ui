# Negative-control mutant — contract staff route (AC-16)
#
# Scenario it must flip: contract.feature >
#   "No staff route is ever reachable from my contract surfaces"
# Test that goes red: contract.mutations.int.test.ts >
#   "AC-16 the payment-method write and its re-read are never addressed to a
#   staff route"
#   (the positive allow-list `allowed.some(path.endsWith)` reads false and
#   `not.toMatch(/cancel_requests\/[^/]+\/(approve|reject|acknowledge|cancel)/)`
#   flips; the replay server also refuses the unmatched URL).
# Mutation: `setPaymentMethod` PATCHes the staff approval route
#   `cancel_requests/{id}/approve` instead of the client route
#   `contracts/{id}/payment_details`.
#
# RE-HOME NOTE: this patch once mutated `requestCancellation`, which moved to
#   `useContractProduct` with R33. The contract keeps ONE write — the
#   payment-method form (R34) — and its AC-16 staff-route scenario now proves
#   THAT write. So the patch stays in the contract module (its spec still covers
#   a contract write), retargeted onto `setPaymentMethod`; the same "a client
#   write escapes onto a staff verb" intent is preserved. The cancellation
#   staff-route control lives beside the contract-product spec
#   (`contract-product.staff-route.must-fail.patch`).
#
# Apply with:  git apply <this file>   (run from repo root)
# Revert with: git apply -R <this file>
diff --git a/packages/headless/src/modules/contract/contract.services.ts b/packages/headless/src/modules/contract/contract.services.ts
index c3bac80a3..0531ddb67 100644
--- a/packages/headless/src/modules/contract/contract.services.ts
+++ b/packages/headless/src/modules/contract/contract.services.ts
@@ -208,7 +208,7 @@ async function setPaymentMethod({
 
   return patch<IContract>({
     mutationKey: [...queryKey, contractId, "payment-method"],
-    url: useUrl(`contracts/${contractId}/payment_details`),
+    url: useUrl(`cancel_requests/${contractId}/approve`),
     data: toPaymentMethodBody(paymentMethod?.model as SetPaymentMethodModel),
     withAccessToken: true
   }).then(invalidateQueryByKey(queryKey, { exact: false }));
