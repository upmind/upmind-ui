{
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "composite": true,
    "outDir": "./dist",
    "declarationDir": "./dist/types", // Correct declaration directory
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitThis": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*"]
}
