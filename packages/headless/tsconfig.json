{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig/vue-library.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@upmind-automation/types": ["../types/src/index.ts"],
      "@upmind-automation/i18n": ["../i18n/src/index.ts"],
      "@upmind-automation/test-fixtures": ["../../tests/fixtures/index.ts"],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "@types/google.maps", "@types/mercadopago-sdk-js"]
  },
  "include": ["src/**/*", "../types/src/**/*", "../i18n/src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.*",
    "**/*.test.*",
    "**/*.no-test.*",
    "**/__tests__/**"
  ]
}
