{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".", // Important for path resolution
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "declarationDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "src/**/*.test.ts"]
}
