{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".", // Important for path resolution
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "declarationDir": "dist",
    "paths": {
      "@upmind-automation/types": ["../types/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "src/**/*.test.ts"],
  "references": [
    { "path": "../types" } // Reference the types package
  ]
}
