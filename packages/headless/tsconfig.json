{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".", // Important for path resolution
    "composite": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "jsdom",
      "vite/client",
      "@types/google.maps",
      "@types/mercadopago-sdk-js"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "src/**/*.*test.ts"],
  "references": [{ "path": "../types" }, { "path": "../i18n" }]
}
