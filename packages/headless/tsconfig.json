{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "baseUrl": ".", // Important for path resolution
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@upmind-automation/types": ["../types/dist/types"] // Path to the types package's .d.ts files
    },
    "resolveJsonModule": true,
    "strict": true,
    "declaration": false,
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "src/**/*.test.ts"],
  "references": [{ "path": "../types" }] // Essential for monorepo dependencies
}
