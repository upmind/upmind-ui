{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".", // Important for path resolution
    "composite": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["jsdom", "vite/client", "@types/google.maps"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "src/**/*.test.ts"],
  "references": [{ "path": "../types" }]
}
