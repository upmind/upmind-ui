VITE_API_URL=https://api.staging.upmind.io
VITE_API_REGION=euc1
VITE_API_NAME=upmind-development
# Brand/tenant origin the API resolves the brand from — sent as the Origin
# header during capture (matches the Playwright webServer domain). Without it
# the API replies 404 "Domain not found!".
RECORDING_BRAND_ORIGIN=http://qa-automation.local:5173
# Registration-activation links for the one-time verify capture. Export the
# values in the shell for that run only; never commit them here.
RECORDING_VERIFY_USERNAME_NO_PASSWORD=
RECORDING_VERIFY_HASH_NO_PASSWORD=
RECORDING_VERIFY_USERNAME_WITH_PASSWORD=
RECORDING_VERIFY_HASH_WITH_PASSWORD=
