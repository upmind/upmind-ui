  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./testing": "./src/testing/index.ts",
    "./testing/client-email/internal-kit": "./src/modules/client-email/__tests__/client-email.internal-kit.ts",
    "./testing/client-email/int-helpers": "./src/modules/client-email/__tests__/client-email.int-helpers.ts",
    "./testing/client-email/feature": "./src/modules/client-email/__tests__/client-email.feature",
    "./testing/client-email/steps": "./src/modules/client-email/__tests__/client-email.steps.ts",
    "./testing/client-email/setup.integration": "./src/modules/client-email/__tests__/setup.integration.ts",
    "./testing/client-email/fixtures/*.json": "./src/modules/client-email/__tests__/fixtures/*.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "reset": "rm -rf {node_modules,dist,*.tsbuildinfo}",
    "build": "pnpm type-check && pnpm build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc -p tsconfig.build.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "test:integration:record": "FIXTURE_MODE=record vitest run --project integration",
    "test:integration:live": "FIXTURE_MODE=live vitest run --project integration",
    "lint": "node ../../.claude/scripts/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../.claude/scripts/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write src/"
  },
