{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "noImplicitThis": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "**/*.d.ts"]
}
