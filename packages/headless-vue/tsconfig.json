{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "declarationDir": "dist",
    "paths": {
      "@upmind-automation/types": ["../types/src"],
      "@upmind-automation/headless": ["../headless/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "src/**/*.test.ts"],
  "references": [
    { "path": "../types" }, // Reference the types package
    { "path": "../headless" } // Reference the headless package
  ]
}
