{
  "name": "@upmind-automation/headless-vue",
  "version": "0.0.5",
  "description": "",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "main": "./dist/headless-vue.umd.cjs",
  "module": "./dist/headless-vue.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/headless-vue.js",
      "require": "./dist/headless-vue.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf {node_modules,dist,*.tsbuildinfo} && rm -rf node_modules && pnpm install",
    "build": "pnpm type-check && pnpm build-only",
    "build-only": "vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@upmind-automation/headless": "workspace:*",
    "@upmind-automation/types": "workspace:*",
    "@xstate/vue": "^2.0.0",
    "lodash-es": "^4.17.21",
    "xstate": "^4.38.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.17.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-istanbul": "^2.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^2.3.0",
    "vite-plugin-vue-devtools": "^7.7.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "vue": "^3.5.1",
    "vue-router": "^4.2.4"
  }
}
