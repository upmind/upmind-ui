{
  "name": "@upmind-automation/headless-vue",
  "version": "0.0.5",
  "description": "",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./dist/upmind-headless-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/upmind-headless-vue.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:dev": "vitest",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix ",
    "format": "prettier --write src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@upmind-automation/headless": "0.0.3",
    "@xstate/vue": "^2.0.0",
    "lodash-es": "^4.17.21",
    "vue-router": "^4.2.4",
    "vue": "^3.5.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.2",
    "@types/lodash-es": "^4.17.9",
    "@types/node": "^18.17.15",
    "@upmind-automation/types": "0.0.0",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vitest/coverage-istanbul": "^2.1.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "@xstate/inspect": "^0.8.0",
    "autoprefixer": "^10",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^22.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.3",
    "typescript": "^5.6.2",
    "vite": "^4.4.9",
    "vitest": "^2.1.1",
    "vue-tsc": "^1.8.11"
  }
}
