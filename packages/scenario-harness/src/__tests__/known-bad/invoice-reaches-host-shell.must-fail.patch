 <template>
   <LayoutProvider>
-    <slot :template="configMeta.ui.template.value" />
+    <slot
+      :template="configMeta.ui.template.value"
+      :layout="orderTemplate(configMeta.ui.template.value)"
+    />
 
     <template #order-summary>
       <Hero
