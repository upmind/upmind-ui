# Negative control — `invoice` reaches into an app's shell for the order page
# templates instead of taking them from its `templates` prop. Page templates are
# app-owned (ADR 023 Amendment 1 change 3); a package reaching them points a
# package at an app, an edge no row of §3's grant matrix carries.
#
# Caught by `eslint`'s `@workspace/no-cross-package-path-imports`, which resolves
# the relative escape to disk and names the package that owns the target.
#
# Intended RED under lint:
#   Import a workspace package by its published specifier — its internals are
#   private. ("../../../../apps/cart/src/shell/modules/order/shell" resolves into apps/cart)
diff --git a/packages/modules-invoice/src/components/Order.vue b/packages/modules-invoice/src/components/Order.vue
index 326fa8b..a821660 100644
--- a/packages/modules-invoice/src/components/Order.vue
+++ b/packages/modules-invoice/src/components/Order.vue
@@ -1,6 +1,6 @@
 <template>
   <LayoutProvider>
-    <slot :template="template" />
+    <slot :template="template" :layout="ORDER_TEMPLATES[template]" />
 
     <template #order-summary>
       <Hero
@@ -203,6 +203,7 @@ import { computed, onUnmounted, provide, ref, watch } from "vue";
 import { useI18n } from "vue-i18n";
 import { useRoute, useRouter } from "vue-router";
 import { UpmAuth as Auth } from "@upmind-automation/auth";
