@@ -1,6 +1,6 @@
 <template>
   <LayoutProvider>
-    <slot :template="template" />
+    <slot :template="template" :layout="PRODUCT_TEMPLATES[template]" />
 
     <template v-if="!isSlotHidden('product-details')" #product-details>
       <slot
