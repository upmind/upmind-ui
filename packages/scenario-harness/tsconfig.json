{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig/node.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.*", "**/*.test.*"]
}
