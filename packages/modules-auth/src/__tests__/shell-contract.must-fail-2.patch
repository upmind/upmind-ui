# Negative control — a package draws a fallback template. A host that leaves
# the brand's chosen arrangement out of its record gets some other page, and no
# error names what it forgot (Amendment 8).
#
# Intended RED:
#   packages/modules-auth/src/__tests__/shell-contract.test.ts
#     "names the arrangement the host left out of its record" (all three pages)

diff --git a/packages/modules-auth/src/shell.ts b/packages/modules-auth/src/shell.ts
--- a/packages/modules-auth/src/shell.ts
+++ b/packages/modules-auth/src/shell.ts
@@ -17,12 +17,7 @@ export function useAuthTemplate(
       const name = template();
       const provided = templates()[name];
 
-      if (!provided) {
-        throw new Error(
-          `[auth/shell] no template passed for "${name}". Add it to the ` +
-            "page's `templates` record."
-        );
-      }
+      if (!provided) return Object.values(templates())[0];
 
       return provided;
     })
