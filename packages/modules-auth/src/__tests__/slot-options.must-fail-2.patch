#     "draws the 'login' page's form with no cross-link by default, and with one where the layout cards it"

diff --git a/packages/modules-auth/src/components/Login.vue b/packages/modules-auth/src/components/Login.vue
--- a/packages/modules-auth/src/components/Login.vue
+++ b/packages/modules-auth/src/components/Login.vue
@@ -46,7 +46,7 @@
           :class="sessionFormWidthVariants({ card })"
           :active="active"
         >
