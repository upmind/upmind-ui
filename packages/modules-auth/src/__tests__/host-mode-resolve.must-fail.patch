# Negative control — the host mode stops deciding FIRST. Both directions consult
# the route the screen named before they consult the mode, so a host that DRIVES
# funnels takes the funnel-free path: the cart's own sign-in leaves the funnel
# behind and lands on whatever route the screen happens to name.
#
# This is the drop the mode exists to prevent, and it is invisible to a suite
# that only covers the funnel-free side — that suite passes against the broken
# code this seam replaced.
#
# Intended RED:
#   src/__tests__/host-mode-resolve.test.ts
#     "takes the funnel's next step in a host that drives funnels"
#     "keeps the funnel's back step even when the screen names a route"
#   src/__tests__/host-mode-back-control.test.ts
#     "gives recovery exactly one control, and it takes the funnel's back step"
#     "keeps recovery's control and sends it to the login screen instead"
#
# Not gradeable by packages/scenario-harness/scripts/verify-negative-controls.mjs:
# that lane grades import-boundary mutants, whose failure its own added `import`
# line names. This mutant adds no import — its failure is behavioural, and the
# two specs above are what grade it.

diff --git a/packages/auth/src/auth.utils.ts b/packages/auth/src/auth.utils.ts
--- a/packages/auth/src/auth.utils.ts
+++ b/packages/auth/src/auth.utils.ts
@@ -42,13 +42,12 @@
    * with neither ends on itself, so the view holds its own step (`hasResolve`).
    */
   function navigateResolved() {
-    if (routingMeta.value.hasFunnels) return navigateNext();
-
     const landing = props.landingRoute;
-    // No funnel to ask and no landing named: this screen is the destination.
-    if (!landing) return Promise.resolve();
+    if (landing) return router.push(landing);
 
-    return router.push(landing);
+    if (routingMeta.value.hasFunnels) return navigateNext();
+
+    return Promise.resolve();
   }
 
   /**
@@ -57,13 +56,12 @@
    * renders no back control there (`hasReject`): its back is the basket.
    */
   function navigateRejected() {
-    if (routingMeta.value.hasFunnels) return navigateBack();
-
     const reject = toValue(options.rejectRoute);
-    // No funnel to ask and no back target: the control is not offered here.
-    if (!reject) return Promise.resolve();
+    if (reject) return router.push(reject);
 
-    return router.push(reject);
+    if (routingMeta.value.hasFunnels) return navigateBack();
+
+    return Promise.resolve();
   }
 
   return { meta, navigateResolved, navigateRejected };
