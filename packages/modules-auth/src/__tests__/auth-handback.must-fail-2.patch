# Negative control — the sign-in hands back as soon as the token lands, before
# the session holds the user. The host re-reads session state and still sees a
# guest.
#
# Intended RED:
#   packages/modules-auth/src/__tests__/auth-handback.test.ts
#     "holds the hand-back until the session holds the user, then resolves once with the model"
#     "rejects once when the user load fails after the token"

diff --git a/packages/modules-auth/src/components/Auth.vue b/packages/modules-auth/src/components/Auth.vue
--- a/packages/modules-auth/src/components/Auth.vue
+++ b/packages/modules-auth/src/components/Auth.vue
@@ -274,15 +274,9 @@
     if (authenticates) {
       // Token issued but the user load failed — escalate to the reject path
       // rather than hang the overlay waiting for a user that never loads.
-      return session
-        .useActions()
-        .whenAuthenticated()
-        .then(() => {
-          emit("resolve", model);
-        })
-        .catch(() => {
-          emit("reject");
-        });
+      void session.useActions().whenAuthenticated();
+      emit("resolve", model);
+      return;
     }
     emit("resolve", model);
   });
