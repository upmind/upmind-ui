# template, record included. Every template then carries the host's seven
# components as a stray `templates` attribute.
#
# Intended RED:
#   packages/modules-auth/src/__tests__/shell-contract.test.ts
#     "the login page > hands the template its routes, and not the record"

diff --git a/packages/modules-auth/src/Login.vue b/packages/modules-auth/src/Login.vue
--- a/packages/modules-auth/src/Login.vue
+++ b/packages/modules-auth/src/Login.vue
@@ -175,7 +175,7 @@ const { component: templateVariant } = useAuthTemplate(
   () => template.value,
   () => props.templates
 );
-const templateProps = computed(() => omit(props, ["templates"]));
+const templateProps = computed(() => props);
 
 const summarySlot: AuthSummarySlotProps = { showWhileLoading: false };
 const { meta: templateMeta } = useAuthTemplates(template);
