# The URL that static assets will load from
CLOUDFRONT_URL={CLOUDFRONT_URL}

# API URL
VITE_API_URL=https://api.staging.upmind.io

# Sentry environment
VITE_APP_SENTRY_ENV=development
# Socket URL
