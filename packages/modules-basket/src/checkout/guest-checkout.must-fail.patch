# guest-checkout.must-fail.patch
#
# Targets: guest-checkout.utils.spec.ts — the authentication term of the
# guest-checkout gate, the clause a merge on this rung dropped.
# Authored by: developer seat (agent-seat-separation.companion.md — the seat that
# knows the exact line it changed authors the mutant; the prover applies it
# blind, confirms RED, then reverts — never reading src to construct it).
#
# Mutates ONE line: drops `isAnonymous` from the gate's single return.
# `canRegisterAsGuest` is the brand toggle ALONE and carries no authentication
# term, so without this clause a visitor who already holds a session is offered
# guest checkout.
#
# Expected RED: 2 of 6.
#   - "withholds the offer from a visitor who already holds a session"
#   - "withholds the offer from an authenticated visitor even when the brand
#     allows it"
# Still GREEN, correctly — the other four each pin a different term.
#
# Why the gate lives here rather than in the template: e2e cannot reach this
# condition. The router takes an authenticated visitor onward instead of
# rendering the register step, so the offer is absent because the surface is
# absent. The Playwright control this replaces mutated the same clause in its
# old inline form and stayed GREEN — proving the coverage, not the code, was
# the problem.
#
# Apply / verify / revert:
#   git apply <this file>                                 # mutate
#   pnpm --filter @upmind-automation/basket test:unit
#   git apply -R <this file>                              # revert — must return to green
#
diff --git a/packages/modules-basket/src/checkout/guest-checkout.utils.ts b/packages/modules-basket/src/checkout/guest-checkout.utils.ts
index f0bf454cfb..c2d3821cd3 100644
--- a/packages/modules-basket/src/checkout/guest-checkout.utils.ts
+++ b/packages/modules-basket/src/checkout/guest-checkout.utils.ts
@@ -24,5 +24,5 @@ export function offersGuestCheckout(terms: {
   const basketSettled = !terms.isBasketLoading;
   const isOneOffBasket = !terms.hasRecurringProducts;
 
-  return isAnonymous && brandAllows && basketSettled && isOneOffBasket;
+  return brandAllows && basketSettled && isOneOffBasket;
 }
