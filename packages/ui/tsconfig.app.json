{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "../vue/src/modules/dac/utils",
    "../vue/src/modules/dac/utils.ts",
    "../vue/src/modules/dac/utils.ts",
    "../vue/src/modules/domain/utils"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
