{
  "name": "@upmind-automation/i18n",
  "version": "0.0.0",
  "description": "Internationalization (i18n) package for Upmind Automation projects.",
  "type": "module",
  "sideEffects": false,
  "keywords": [],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>",
    "Rafael Macedo <rafael.macedo@upmind.com>",
    "Rhodri Jones <rhodri.jones@upmind.com>"
  ],
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "clean": "rm -rf {node_modules,dist,*.tsbuildinfo}",
    "build": "pnpm type-check && pnpm build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "localazy": "localazy upload",
    "localazy:sync": "localazy upload --config localazy.sync.json && localazy download --config localazy.sync.json && pnpm format"
  },
  "dependencies": {
    "@localazy/cli": "^2.0.8",
    "dompurify": "^3.2.6",
    "lodash-es": "^4.17.21",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.17.1",
    "@types/object-hash": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "~10.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vue-i18n": "^11.1.11"
  }
}
