{
  "name": "@upmind-automation/i18n",
  "version": "0.0.0",
  "description": "Internationalization (i18n) package for Upmind Automation projects.",
  "type": "module",
  "sideEffects": false,
  "keywords": [],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>",
    "Rafael Macedo <rafael.macedo@upmind.com>",
    "Rhodri Jones <rhodri.jones@upmind.com>"
  ],
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "reset": "rm -rf node_modules",
    "lint": "node ../../scripts/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../scripts/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write src/",
    "localazy": "localazy upload",
    "localazy:download": "localazy download --config localazy.sync.json && pnpm format",
    "localazy:overwrite": "localazy upload --config localazy.sync.json"
  },
  "dependencies": {
    "@localazy/cli": "^2.0.8",
    "dompurify": "^3.2.6",
    "lodash-es": "^4.17.21",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vue-i18n": "^11.1.11"
  }
}
