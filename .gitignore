# Only ad-hoc / brand-specific capture dirs (recordings-velia/, etc.) are ignored.
tests/fixtures/recordings-*/
.playwright-mcp/


# Git worktrees
.worktrees/

# Asset registry (post-build chunk manifests)
.asset-registry/

# ============================================
# Graphify — commit graph.json + GRAPH_REPORT.md at the repo ROOT only; ignore
# everything else it generates. Committing graph.json is what makes the graph
# work in fresh worktrees, submodules, and cloud agents (they see tracked files
# only). Keep the tooling in .claude/scripts/graphify/ versioned.
# ============================================
# Root graphify-out/: ignore ALL of it, then re-include exactly the two tracked
# artifacts. Any future derived file (graph.html, graph-modules.*, wiki/, cache/,
# manifest, cost, .graphify_*, .refresh_marker) is auto-ignored by the wildcard.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
# Per-package graphs are local convenience only — never committed. Ignore each
# workspace package's whole graphify-out/ (submodules keep their own copy clean
# via .git/info/exclude, set by refresh.sh).
apps/*/graphify-out/
packages/*/graphify-out/
playgrounds/*/graphify-out/
docs/graphify-out/
tests/*/graphify-out/
# python bytecode from the graphify scripts; settings backup from `graphify claude install`
.claude/scripts/graphify/__pycache__/
.claude/settings.json.graphify-bak
repos/monorepo
repos/vue-app

# Corpus build reflection artifact — regenerated per build by docs/corpus/build.mjs
# and consumed by the drift gates via CI `needs:` (not a committed file, FE-2752 T3).
docs/corpus/.reflection.json

# gate:examples' throwaway type-check project — always removed before the gate
# exits; ignored defensively in case a run is interrupted (FE-2752 T8).
docs/corpus/.gate-examples-tmp-*/

# Transient agent-generated docs. No trailing slash: a bare path also ignores a
# symlink at it, which a directory-only pattern lets through.
.docs
docs/analysis
docs/plans
docs/audit
docs/reviews
docs/decisions
docs/stories
docs/sdd
