@@ -16,9 +16,5 @@ export const DOMAIN_TEMPLATES: Record<DOMAIN_TEMPLATE.FULL, Component> = {
 export function domainTemplate(
   template: string = DOMAIN_TEMPLATE.FULL
 ): Component {
-  return get(
-    DOMAIN_TEMPLATES,
-    template,
-    DOMAIN_TEMPLATES[DOMAIN_TEMPLATE.FULL]
-  );
