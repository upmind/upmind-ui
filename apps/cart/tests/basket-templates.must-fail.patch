# Negative control — every one of the cart's five basket-family picks is declared
# with the other two-column layout as its fallback, so a brand with no template,
# an empty one, or a name the family does not carry gets the mirror of its page.
#
# Intended RED (apps/cart/tests/basket-templates.test.ts), in each of
# basketTemplate, basketProductTemplate, billingTemplate, checkoutTemplate and
# productSetupTemplate:
#   draws the <fallback> layout for no template
#   draws the <fallback> layout for an empty template
#   draws the <fallback> layout for "not-a-template", which none of its layouts carries
#   draws the <fallback> layout for "constructor", which none of its layouts carries
#   (productSetupTemplate also) draws the two-column-rtl layout for "inset", ...
# Intended GREEN:
#   draws the layout the <template> template carries

diff --git a/apps/cart/src/shell/modules/basket/shell.ts b/apps/cart/src/shell/modules/basket/shell.ts
--- a/apps/cart/src/shell/modules/basket/shell.ts
+++ b/apps/cart/src/shell/modules/basket/shell.ts
@@ -23,5 +23,5 @@
 
 export const basketTemplate = resolveTemplate(
   BASKET_TEMPLATES,
-  BASKET_TEMPLATE.TWO_COLUMN_LTR
+  BASKET_TEMPLATE.TWO_COLUMN_RTL
 );
