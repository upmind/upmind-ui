{
  "name": "@upmind-automation/cart",
  "private": true,
  "version": "0.1.9",
  "description": "Bespoke Vue.js, e-commerce platform built on the Upmind platform",
  "keywords": [
    "Upmind",
    "billing",
    "sales",
    "automation",
    "platform",
    "service business",
    "shopping cart",
    "e-commerce"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>",
    "Rhodri Jones <rhodri.jones@upmind.com>"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "clean": "rm -rf {node_modules,dist,*.tsbuildinfo} && rm -rf node_modules && pnpm install",
    "start": "pnpm dev",
    "dev": "vite",
    "build": "pnpm type-check && pnpm build-only",
    "build:staging": "pnpm type-check && vite build --mode staging",
    "build-only": "vite build",
    "type-check": "vue-tsc -p tsconfig.build.json  --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "localazy": "localazy upload",
    "localazy:download": "localazy download",
    "localazy:sync": "localazy upload && localazy download",
    "deploy:preview": "pnpm build && firebase cart:channel:deploy $(git branch --show-current) --only hosting:cart",
    "deploy:staging": "pnpm build:staging  && firebase deploy --only hosting:staging",
    "deploy": "pnpm build && firebase deploy --only hosting:cart"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@sentry/vue": "^9.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/vue-query": "^5.67.1",
    "@upmind-automation/client-vue": "workspace:*",
    "@upmind-automation/upmind-ui": "workspace:*",
    "@vueuse/components": "^12.7.0",
    "@vueuse/core": "^12.7.0",
    "class-variance-authority": "^0.7.1",
    "lodash-es": "^4.17.21",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-aria-attributes": "^2.0.1",
    "tailwindcss-themer": "^4.1.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.1",
    "vue-router": "^4.5.0",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@localazy/cli": "^1.7.15",
    "@playwright/test": "^1.50.1",
    "@sentry/vite-plugin": "^3.2.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-istanbul": "^3.0.5",
    "@vitest/eslint-plugin": "^1.1.31",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "postcss-import": "^16.1.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "^1.84.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.24.0"
  }
}
