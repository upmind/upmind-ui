{
  "name": "@upmind-automation/cart",
  "private": true,
  "version": "0.1.14",
  "description": "Bespoke Vue.js, e-commerce platform built on the Upmind platform",
  "keywords": [
    "Upmind",
    "billing",
    "sales",
    "automation",
    "platform",
    "service business",
    "shopping cart",
    "e-commerce"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>",
    "Rhodri Jones <rhodri.jones@upmind.com>"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "clean": "rm -rf {node_modules,dist,*.tsbuildinfo} && rm -rf node_modules && pnpm install",
    "start": "pnpm dev",
    "dev": "vite",
    "build": "pnpm type-check && pnpm build-only",
    "build:staging": "pnpm type-check && vite build --mode staging",
    "build-only": "vite build",
    "type-check": "vue-tsc -p tsconfig.build.json  --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "localazy": "localazy upload",
    "localazy:download": "localazy download",
    "localazy:sync": "localazy upload && localazy download",
    "deploy:preview": "pnpm build && firebase cart:channel:deploy $(git branch --show-current) --only hosting:cart",
    "deploy:staging": "pnpm build:staging  && firebase deploy --only hosting:staging",
    "deploy": "pnpm build && firebase deploy --only hosting:cart"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@sentry/vue": "^10.4.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/vue-query": "^5.83.1",
    "@upmind-automation/client-vue": "workspace:*",
    "@upmind-automation/upmind-ui": "workspace:*",
    "@vueuse/components": "^13.6.0",
    "@vueuse/core": "^13.6.0",
    "class-variance-authority": "^0.7.1",
    "lodash-es": "^4.17.21",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@localazy/cli": "^2.0.8",
    "@playwright/test": "^1.54.2",
    "@sentry/vite-plugin": "^4.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.17.1",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5",
    "wrangler": "^4.28.1"
  }
}
