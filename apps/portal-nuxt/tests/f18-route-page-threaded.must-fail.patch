# the route context reaches the page's own context"
# (tests/fourteenth-closure.test.ts).

--- a/apps/portal-nuxt/app/pages/[...slug].vue
+++ b/apps/portal-nuxt/app/pages/[...slug].vue
@@ -86,7 +86,12 @@
  * typing the URL.
  */
 function queryFilters(): DataRouteContext {
-  return routeQueryContext(route.query);
+  return {
+    productType: routeQueryValue(route.query, "type"),
+    category: routeQueryValue(route.query, "category"),
+    status: routeQueryValue(route.query, "status"),
+    orderComplete: routeQueryValue(route.query, "orderComplete")
+  };
 }
 
