# Negative control — the sign-in page ignores the raw template its screen hands
# back and always draws the default layout, so a brand's chosen arrangement
# never reaches the portal's sign-in page.
#
# Intended RED (tests/auth-landing.test.ts):
#   "draws the portal's layout for the raw template the sign-in screen hands back"

diff --git a/apps/portal-nuxt/app/pages/login.vue b/apps/portal-nuxt/app/pages/login.vue
--- a/apps/portal-nuxt/app/pages/login.vue
+++ b/apps/portal-nuxt/app/pages/login.vue
@@ -1,6 +1,6 @@
 <template>
   <UpmAuthLogin v-bind="AUTH_ROUTES" @resolve="onResolve" v-slot="{ template }">
-    <component :is="authTemplate(template)" />
+    <component :is="authTemplate()" />
   </UpmAuthLogin>
 </template>
 
