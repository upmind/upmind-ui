#   "sends recovery's back to the sign-in screen"

diff --git a/apps/portal-nuxt/app/pages/forgotten-password.vue b/apps/portal-nuxt/app/pages/forgotten-password.vue
--- a/apps/portal-nuxt/app/pages/forgotten-password.vue
+++ b/apps/portal-nuxt/app/pages/forgotten-password.vue
@@ -2,7 +2,6 @@
   <UpmAuthRecoverPassword
     v-bind="AUTH_ROUTES"
     :templates="PORTAL_AUTH_TEMPLATES"
-    @reject="onReject"
   />
 </template>
 
