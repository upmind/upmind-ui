# Intended RED: "profile-save writes every native field back to the persona"
# (tests/form-exemplars.test.ts).

--- a/apps/portal-nuxt/app/portal/mock/facades/useMockPersonalDetails.ts
+++ b/apps/portal-nuxt/app/portal/mock/facades/useMockPersonalDetails.ts
@@ -53,10 +53,7 @@
      */
     saveProfile: (model: FormModel): MockActionReceipt<MockPersona> => {
       assign(data.persona, {
-        firstName: savedField(model, "firstName"),
-        lastName: savedField(model, "lastName"),
-        publicName: savedField(model, "publicName"),
-        language: savedField(model, "language")
+        firstName: savedField(model, "firstName")
       });
       return { ok: true, entity: data.persona };
     },
