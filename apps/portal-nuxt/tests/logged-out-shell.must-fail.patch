# Negative control — the logged-out footer names the platform unconditionally,
# so a brand that has bought the branding out still carries "Powered by Upmind"
# on every screen a signed-out visitor sees.
#
# Intended RED: "names the platform only where the brand allows it to be named"
# (tests/logged-out-shell.test.ts), the layout frame.

diff --git a/apps/portal-nuxt/app/layouts/logged-out.vue b/apps/portal-nuxt/app/layouts/logged-out.vue
--- a/apps/portal-nuxt/app/layouts/logged-out.vue
+++ b/apps/portal-nuxt/app/layouts/logged-out.vue
@@ -81,7 +81,7 @@ watch(activeConfig, config => setTheme(config.theme ?? "upmind"), {
           :model-value="footerMarkdown"
           :class="PORTAL_FOOTER_PROSE_CLASS"
         />
-        <PortalUpmind v-if="hasUpmindBranding" />
+        <PortalUpmind />
       </template>
     </AuthShell>
     <Toaster />
