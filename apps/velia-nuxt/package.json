{
  "name": "@upmind-automation/velia-nuxt",
  "private": true,
  "version": "0.20.17",
  "description": "Velia's checkout — the cart-nuxt Nuxt layer with Velia's basket URL segment",
  "keywords": [
    "Upmind",
    "billing",
    "sales",
    "automation",
    "platform",
    "service business",
    "shopping cart",
    "e-commerce"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>",
    "Rhodri Jones <rhodri.jones@upmind.com>"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "reset": "rm -rf node_modules dist .nuxt .output node_modules/.cache node_modules/.vite *.tsbuildinfo",
    "start": "pnpm dev",
    "dev": "nuxt dev --dotenv .env.development",
    "build:prod": "pnpm type-check && pnpm generate",
    "build:staging": "pnpm type-check && nuxt generate --mode staging --dotenv .env.staging",
    "build-only": "nuxt build",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "type-check": "nuxt typecheck",
    "preview": "nuxt preview",
    "lint": "node ../../etc/ci/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../etc/ci/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write .",
    "deploy:gcs": "bash ../../etc/scripts/deploy-gcs.sh --bucket upmind-cart --prefix velia --dist .output/public",
    "deploy:gcs:staging": "bash ../../etc/scripts/deploy-gcs.sh --bucket upmind-cart-staging --prefix velia --dist .output/public",
    "verify:gcs": "bash ../../etc/scripts/verify-gcs.sh --bucket upmind-cart --prefix velia --dist .output/public",
    "verify:gcs:staging": "bash ../../etc/scripts/verify-gcs.sh --bucket upmind-cart-staging --prefix velia --dist .output/public",
    "deploy:firebase": "firebase deploy --only hosting:velia",
    "deploy:firebase:staging": "firebase deploy --only hosting:staging",
    "deploy": "pnpm build:prod && pnpm deploy:gcs && pnpm deploy:firebase",
    "deploy:staging": "pnpm build:staging && pnpm deploy:gcs:staging && pnpm deploy:firebase:staging"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@nuxtjs/seo": "^3.3.0",
    "@nuxtjs/web-vitals": "^0.2.7",
    "@sentry/nuxt": "^10.34.0",
    "@sentry/vue": "^10.4.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/vue-query": "^5.83.1",
    "@upmind-automation/auth": "workspace:*",
    "@upmind-automation/basket": "workspace:*",
    "@upmind-automation/catalogue": "workspace:*",
    "@upmind-automation/client": "workspace:*",
    "@upmind-automation/domain": "workspace:*",
    "@upmind-automation/foundation": "workspace:*",
    "@upmind-automation/i18n": "workspace:*",
    "@upmind-automation/invoice": "workspace:*",
    "@upmind-automation/payment": "workspace:*",
    "@upmind-automation/product": "workspace:*",
    "@upmind-automation/recommendations": "workspace:*",
    "@upmind-automation/types": "workspace:*",
    "@upmind/tokens": "workspace:*",
    "@vueuse/components": "^13.6.0",
    "@vueuse/core": "^13.6.0",
    "@vueuse/nuxt": "^13.6.0",
    "class-variance-authority": "^0.7.1",
    "lodash-es": "^4.17.21",
    "nuxt": "^4.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@localazy/cli": "^2.0.8",
    "@nuxt/eslint": "^1.5.0",
    "@playwright/test": "^1.54.2",
    "@sentry/vite-plugin": "^4.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tsconfig/node22": "^22.0.2",
    "@types/google.maps": "^3.58.1",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/mercadopago-sdk-js": "^2.0.17",
    "@types/node": "^22.17.1",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5",
    "wrangler": "^4.28.1"
  }
}
