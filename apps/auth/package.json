{
  "name": "@upmind-automation/auth-app",
  "private": true,
  "version": "0.20.17",
  "description": "The standalone Upmind auth app — boots from a return target, runs the login/register/2FA/recover flows, and hands back.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "reset": "rm -rf {node_modules,dist,*.tsbuildinfo}",
    "start": "pnpm dev",
    "predev": "pnpm --filter @upmind/tokens build",
    "dev": "vite",
    "build": "pnpm type-check && pnpm build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "lint": "node ../../etc/ci/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../etc/ci/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@upmind-automation/auth": "workspace:*",
    "@upmind-automation/foundation": "workspace:*",
    "@upmind-automation/headless": "workspace:*",
    "@upmind-automation/i18n": "workspace:*",
    "@upmind-automation/types": "workspace:*",
    "@upmind/tokens": "workspace:*",
    "@upmind/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.17.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
