# stand-alone sign-in app does nothing after a sign-in (O4); a landing here is
# the navigation that ruling removed.
#
# Intended RED:
#   apps/auth/tests/routes.test.ts
#     "hands every sign-in route its three routes, and no landing"

diff --git a/apps/auth/src/routes.ts b/apps/auth/src/routes.ts
--- a/apps/auth/src/routes.ts
+++ b/apps/auth/src/routes.ts
@@ -22,7 +22,8 @@
 const authRouteProps = {
   loginRoute: { name: AUTH_ROUTE.LOGIN },
   registerRoute: { name: AUTH_ROUTE.REGISTER },
-  recoverRoute: { name: AUTH_ROUTE.RECOVER }
+  recoverRoute: { name: AUTH_ROUTE.RECOVER },
+  landingRoute: { name: AUTH_ROUTE.LANDING }
 };
 
 const { loginRoute, registerRoute, recoverRoute } = authRouteProps;
