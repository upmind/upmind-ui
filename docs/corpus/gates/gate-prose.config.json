{
  "ignorePaths": [
    ".claude/",
    ".git/",
    "docs/published-docs/",
    "docs/corpus/fixtures/",
    "tests/Playwright/",
    "graphify-out/",
    "design-system/",
    "packages/types/"
  ],
  "ignoreDirNames": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist",
    "build",
    "coverage",
    "storybook-static",
    "graphify-out",
    ".git"
  ],
  "ignoreFileNames": ["CLAUDE.md"],
  "personaAllowed": ["README.md", "guide.md", "/guides/", "docs/learn/"],
  "appNames": [
    "cart",
    "cart-nuxt",
    "hosting",
    "velia",
    "webcentral",
    "portal-nuxt",
    "auth",
    "payment"
  ],
  "fillerWords": ["basically", "simply", "just", "obviously"],
  "trackerIdPattern": "\\bFE-\\d{3,5}\\b",
  "processTokens": [
    "\\bD[1-4]\\b",
    "@decision",
    "\\bAC-[A-Z]?\\d",
    "Cell [AB]\\b",
    "\\bPRESENT\\b",
    "\\bABSENT\\b",
    "Repair cycle",
    "gap #\\d",
    "\\bADR-\\d+",
    "docs/sdd/",
    "\\bevidence/",
    "parity\\.yaml",
    "research\\.md",
    "verify\\.md",
    "test-report\\.md",
    "operator-ruling-[\\w-]*\\.md"
  ],
  "prescriptivePhrases": [
    "you should",
    "every consumer must",
    "everyone awaits",
    "plan for",
    "the cleaner shape is",
    "the natural separation is",
    "if you implement one thing first",
    "our implementation",
    "we chose"
  ],
  "stateModelWords": [
    "loading",
    "checking",
    "idle",
    "processing",
    "ready",
    "refreshing",
    "subscribing",
    "expired"
  ],
  "frameworkWords": [
    "computed",
    "ref",
    "watch",
    "spawn",
    "useQuery",
    "query key",
    ".as("
  ],
  "clientBagKey": null,
  "sddWords": {
    "shall": "must",
    "both": "the two",
    "exist": "be",
    "whether": "if",
    "ensure": "make sure",
    "verify": "make sure",
    "confirm": "make sure",
    "emit": "send"
  },
