{
  "glossary": {
    "terms": {
      "account": {
        "aliases": [
          "client lifecycle"
        ],
        "definition": "The post-auth standing arc a client moves through — unregistered, unverified, verified — scoped by actor and managed by the account composable.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useAccount",
            "type": "symbol"
          }
        ],
        "term": "account"
      },
      "auth": {
        "aliases": [
          "authentication",
          "login"
        ],
        "definition": "Unified authentication for guest, client, and staff actors — login, registration, and session establishment, handled by the auth composable.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useAuth",
            "type": "symbol"
          }
        ],
        "term": "auth"
      },
      "basket": {
        "aliases": [],
        "definition": "The customer's in-progress order — the collection of products, billing cycles, promotions, and currency selected before checkout. The headless basket is the reactive source of truth the storefront app reads and mutates.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useBasket",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!BasketContext",
            "type": "symbol"
          }
        ],
        "term": "basket"
      },
      "billing": {
        "aliases": [
          "basket billing",
          "billing cycle"
        ],
        "definition": "The billing details attached to a basket — validating, updating, and clearing them, and observing the billing lifecycle's state transitions — managed by the basket billing composable.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useBasketBilling",
            "type": "symbol"
          }
        ],
        "term": "billing"
      },
      "brand": {
        "aliases": [],
        "definition": "The white-labelled organisation a storefront runs as — its settings, configuration values, and enabled modules, fetched and unified by the brand composable.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useBrand",
            "type": "symbol"
          }
        ],
        "term": "brand"
      },
      "cart": {
        "aliases": [],
        "definition": "The Vue.js storefront app (`apps/cart`) that renders the customer-facing basket and checkout UI. It is a consumer of the headless business logic and the client-vue integration layer, not the basket concept itself — see the package-layer split in ADR-007.",
        "kind": "system",
        "referents": [
          {
            "id": "adr:007-headless-architecture",
            "type": "adr"
          }
        ],
        "term": "cart"
      },
      "client": {
        "aliases": [
          "client profile"
        ],
        "definition": "The authenticated customer's profile and account standing — identity, contact details, and the account-lifecycle state (unregistered, unverified, verified) layered on top of it.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!Client",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!Account",
            "type": "symbol"
          }
        ],
        "term": "client"
      },
      "currency": {
        "aliases": [
          "display currency"
        ],
        "definition": "The currency a basket is priced and displayed in. Changing the basket currency re-prices every line item; the selection is managed by the basket currency composable.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useBasketCurrency",
            "type": "symbol"
          }
        ],
        "term": "currency"
      },
      "domain": {
        "aliases": [
          "domain name"
        ],
        "definition": "A domain-name product — searched for availability, registered or transferred, and configured as part of an order. Domain search and lifecycle are handled by the domain composable.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useDomain",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!DomainModel",
            "type": "symbol"
          }
        ],
        "term": "domain"
      },
      "feedback": {
        "aliases": [
          "notifications"
        ],
        "definition": "User-facing messages — errors, successes, warnings, and system notifications — added, dismissed, and displayed through a global feedback state machine.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useFeedback",
            "type": "symbol"
          }
        ],
        "term": "feedback"
      },
      "invoice": {
        "aliases": [
          "bill"
        ],
        "definition": "The billable document raised for an order — client, currency, line items, payment history, and the paid/unpaid amount summary. Invoice data is loaded and invalidated by the invoice composable.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useInvoice",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!Invoice",
            "type": "symbol"
          }
        ],
        "term": "invoice"
      },
      "order": {
        "aliases": [
          "purchase"
        ],
        "definition": "The invoice-payment lifecycle a basket converts into at checkout — orchestrated by the order machine, which spawns the payment-detail actor and drives retry and partial-payment loops until the invoice is settled.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useOrder",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!OrderContext",
            "type": "symbol"
          }
        ],
        "term": "order"
      },
      "payment": {
        "aliases": [
          "payment method"
        ],
        "definition": "The state, context, and actions that orchestrate a single payment attempt against a gateway — meta-information, error handling, and the pay/refresh event triggers, driven by the payment composable's state machine.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!usePayment",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!PaymentContext",
            "type": "symbol"
          }
        ],
        "term": "payment"
      },
      "payment-gateway": {
        "aliases": [
          "gateway"
        ],
        "definition": "A provider integration (Stripe, PayPal, and others) that authorises and captures payment for an order. Gateways are abstracted behind a common interface so the checkout flow is provider-agnostic.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!usePaymentGateway",
            "type": "symbol"
          },
          {
            "id": "adr:015-payment-gateway-abstractions",
            "type": "adr"
          }
        ],
        "term": "payment gateway"
      },
      "product": {
        "aliases": [
          "catalogue product"
        ],
        "definition": "A sellable item in a brand's catalogue — hosting plans, domains, add-ons — with its pricing, billing cycles, and configuration options. Products are browsed via the catalogue and added to the basket.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useProductCatalogue",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!Product",
            "type": "symbol"
          }
        ],
        "term": "product"
      },
      "promotion": {
        "aliases": [
          "coupon",
          "discount"
        ],
        "definition": "A discount or offer applied to a basket, typically via a promo code, that adjusts line-item or order totals. Promotions are validated and applied through the basket promotions composable.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useBasketPromotions",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!PromotionModel",
            "type": "symbol"
          }
        ],
        "term": "promotion"
      },
      "query": {
        "aliases": [
          "tanstack query",
          "query client"
        ],
        "definition": "The TanStack Query layer that fetches, caches, and invalidates server data behind every composable. Query keys and the shared query client are exposed through the query composable.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useQuery",
            "type": "symbol"
          },
          {
            "id": "adr:006-tanstack-query",
            "type": "adr"
          }
        ],
        "term": "query"
      },
      "recommendations": {
        "aliases": [
          "product recommendations",
          "upsell"
        ],
        "definition": "Suggested products surfaced from the recommendation engine — either scoped to a specific product (for product-detail or post-add-to-basket upsell) or fetched generally — via the recommendations composables.",
        "kind": "domain",
        "referents": [
          {
            "id": "@upmind-automation/headless!useProductRecommendations",
            "type": "symbol"
          },
          {
            "id": "@upmind-automation/headless!useRecommendations",
            "type": "symbol"
          }
        ],
        "term": "recommendations"
      },
      "routing": {
        "aliases": [
          "funnel navigation"
        ],
        "definition": "Route management, navigation, and flow control across the storefront — integrating internationalisation, session, and basket state to resolve routes and drive funnel progression.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useRoutingEngine",
            "type": "symbol"
          },
          {
            "id": "adr:017-funnel-navigation-via-state-meta",
            "type": "adr"
          }
        ],
        "term": "routing"
      },
      "scope": {
        "aliases": [
          "scoped composable"
        ],
        "definition": "The keyed registry mechanism that gives each composable instance an isolated, reusable footprint so multiple baskets or products can coexist on one page without sharing state. Scope keys namespace every module's reactive state.",
        "kind": "system",
        "referents": [
          {
            "id": "adr:001-scope-based-composables",
            "type": "adr"
          }
        ],
        "term": "scope"
      },
      "session": {
        "aliases": [
          "auth session"
        ],
        "definition": "The authenticated (or guest) context a basket and its actions run within, including the current client, brand, and access tokens. Session state is coordinated by the session composable and its state machine.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useSessionStore",
            "type": "symbol"
          },
          {
            "id": "adr:002-session-and-service-architecture",
            "type": "adr"
          }
        ],
        "term": "session"
      },
      "system": {
        "aliases": [
          "reference data"
        ],
        "definition": "Brand-agnostic reference data (countries, currencies, statuses, billing cycles, ticket departments, and similar lookups) exposed through the system composable.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useSystem",
            "type": "symbol"
          }
        ],
        "term": "system"
      },
      "theming": {
        "aliases": [
          "theme"
        ],
        "definition": "The per-brand visual configuration (colours, typography, layout tokens) that lets one headless codebase render many branded storefronts. Theme values are resolved by the theming composable.",
        "kind": "system",
        "referents": [
          {
            "id": "@upmind-automation/headless!useTheming",
            "type": "symbol"
          },
          {
            "id": "adr:012-multi-theme-architecture",
            "type": "adr"
          }
        ],
        "term": "theming"
      }
    }
  },
