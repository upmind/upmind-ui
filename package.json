{
  "name": "upmind-automation",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "playgrounds/*"
  ],
  "version": "0.4.2",
  "description": "This monorepo serves as the central hub for Upmind's second-generation UI components and business logic. It provides reusable packages for core functionalities (Headless) and Vue.js implementations (Headless-vue), along with playgrounds demonstrating UI integration using",
  "keywords": [
    "upmind",
    "billing",
    "sales",
    "automation",
    "platform",
    "service business",
    "shopping cart",
    "e-commerce",
    "forms",
    "ui components",
    "vue.js",
    "javascript",
    "xstate",
    "tailwind",
    "storybook"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@git.upmind.io:upmind/upmind-monorepo.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "clean": "pnpm -r clean && rm -rf node_modules && pnpm install",
    "start": "pnpm -r start",
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "test:chrome": "pnpm playwright test /e2e-tests --project=chrome",
    "test:firefox": "pnpm playwright test /e2e-tests --project=firefox",
    "test:safari": "pnpm playwright test /e2e-tests --project=safari",
    "test:all-browsers": "pnpm playwright test /e2e-tests",
    "test:ui": "pnpm playwright test --ui",
    "visreg:chrome": "pnpm playwright test /visual-regression --project=chrome",
    "outdated": "pnpm outdated -r",
    "graph": "bash .agent/scripts/graphify/refresh.sh",
    "graph:check": "bash .agent/scripts/graphify/refresh.sh --check",
    "graph:open": "open graphify-out/graph.html",
    "graph:open:modules": "open graphify-out/graph-modules.html"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.54.2",
    "@rushstack/eslint-patch": "^1.12.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.17.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "~10.4.0",
    "firebase-tools": "^14.12.0",
    "husky": "9.1.7",
    "lint-staged": "^15.5.2",
    "pnpm": "^10.14.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5",
    "wrangler": "^4.56.0"
  },
  "dependencies": {
    "otpauth": "^9.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14"
  }
}
