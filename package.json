{
  "name": "upmind-automation",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "playgrounds/*"
  ],
  "version": "0.0.1",
  "description": "This monorepo serves as the central hub for Upmind's second-generation UI components and business logic. It provides reusable packages for core functionalities (Headless) and Vue.js implementations (Headless-vue), along with playgrounds demonstrating UI integration using",
  "keywords": [
    "upmind",
    "billing",
    "sales",
    "automation",
    "platform",
    "service business",
    "shopping cart",
    "e-commerce",
    "forms",
    "ui components",
    "vue.js",
    "javascript",
    "xstate",
    "tailwind",
    "storybook"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@git.upmind.io:upmind/upmind-monorepo.git"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "clean": "rm -rf */**/{node_modules,dist,bin,lib,*.tsbuildinfo} && rm -rf node_modules && pnpm install",
    "start": "pnpm -r start",
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@playwright/test": "^1.50.1",
    "@rushstack/eslint-patch": "^1.10.5",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-istanbul": "^3.0.6",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^9.32.0",
    "firebase-tools": "^13.31.1",
    "husky": "9.1.7",
    "lint-staged": "^15.4.3",
    "pnpm": "^10.4.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vue-tsc": "^2.2.2"
  },
  "dependencies": {
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
