{
  "name": "upmind-automation",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "playgrounds/*"
  ],
  "version": "0.20.12",
  "description": "This monorepo serves as the central hub for Upmind's second-generation UI components and business logic. It provides reusable packages for core functionalities (Headless) and Vue.js implementations (Headless-vue), along with playgrounds demonstrating UI integration using",
  "keywords": [
    "upmind",
    "billing",
    "sales",
    "automation",
    "platform",
    "service business",
    "shopping cart",
    "e-commerce",
    "forms",
    "ui components",
    "vue.js",
    "javascript",
    "xstate",
    "tailwind",
    "storybook"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@git.upmind.io:upmind/upmind-monorepo.git"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "reset": "pnpm -r run reset && rm -rf node_modules && pnpm install",
    "start": "pnpm -r start",
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint:verify": "node .claude/scripts/lint/verify-lint-convergence.mjs",
    "format": "pnpm -r format",
    "test": "pnpm -r test && pnpm test:bdd",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:journeys": "pnpm --filter @upmind-automation/journeys test",
    "typecheck:journeys": "tsc -p tests/journeys/tsconfig.json --noEmit",
    "test:bdd": "bddgen --config=playwright.bdd.config.ts && playwright test --config=playwright.bdd.config.ts",
    "record": "node tests/fixtures/recording-proxy.mjs",
    "record:cases": "node --experimental-strip-types tests/fixtures/record-cases.ts",
    "fixtures:generate": "node tests/fixtures/generate.mjs",
    "lint:fixtures": "node tests/fixtures/lint-fixtures.mjs",
    "lint:features": "bash tests/features/lint-feature-files.sh",
    "lint:quarantine": "node tests/quarantine/lint-quarantine.mjs",
    "test:quarantined": "node tests/quarantine/list-quarantined.mjs",
    "quarantine:flaky": "node tests/quarantine/allure-flaky-report.mjs",
    "quarantine:enforce": "node tests/quarantine/quarantine-enforce.mjs",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "test:e2e": "bash tests/Playwright/scripts/run-e2e.sh",
    "test:chrome": "bash tests/Playwright/scripts/run-e2e.sh chrome",
    "test:firefox": "bash tests/Playwright/scripts/run-e2e.sh firefox",
    "test:safari": "bash tests/Playwright/scripts/run-e2e.sh safari",
    "test:all-browsers": "bash tests/Playwright/scripts/run-e2e.sh all",
    "test:ui": "pnpm playwright test --ui",
    "visreg:chrome": "pnpm playwright test /visual-regression --project=chrome",
    "outdated": "pnpm outdated -r",
    "allure:generate": "bash tests/allure/allure-generate.sh",
    "allure:open": "npx --no-install allure open tests/Playwright/e2e/reports/allure-report",
    "allure:serve": "pnpm allure:generate && npx --no-install allure open tests/Playwright/e2e/reports/allure-report",
    "allure:publish:local": "bash tests/allure/allure-publish-local.sh",
    "allure:index": "node tests/allure/allure-index.mjs",
    "graph": "bash .claude/scripts/graphify/refresh.sh",
    "graph:check": "bash .claude/scripts/graphify/refresh.sh --check",
    "graph:open": "open graphify-out/graph.html",
    "graph:open:modules": "open graphify-out/graph-modules.html"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.54.2",
    "@rushstack/eslint-patch": "^1.12.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.17.1",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "@upmind-automation/eslint-plugin-scope-based": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/tsconfig": "^0.7.0",
    "allure": "^3.6.2",
    "allure-js-commons": "^3.7.1",
    "allure-playwright": "^3.7.1",
    "concurrently": "^9.2.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-unused-imports": "4.3.0",
    "eslint-plugin-vue": "10.4.0",
    "firebase-tools": "^14.12.0",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "lint-staged": "^15.5.2",
    "playwright-bdd": "^9.2.0",
    "pnpm": "^10.14.0",
    "prettier": "3.7.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "^3.0.5",
    "wrangler": "^4.56.0"
  },
  "dependencies": {
    "otpauth": "^9.4.0",
    "prettier-plugin-tailwindcss": "0.6.14"
  }
}
