{
  "name": "upmind-automation",
  "version": "0.0.0",
  "description": "This monorepo serves as the central hub for Upmind's second-generation UI components and business logic. It provides reusable packages for core functionalities (Headless) and Vue.js implementations (Headless-vue), along with playgrounds demonstrating UI integration using",
  "private": true,
  "keywords": [
    "upmind",
    "billing",
    "sales",
    "automation",
    "platform",
    "service business",
    "shopping cart",
    "e-commerce",
    "forms",
    "ui components",
    "vue.js",
    "javascript",
    "xstate",
    "tailwind",
    "storybook"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@git.upmind.io:upmind/upmind-monorepo.git"
  },
  "scripts": {
    "preinstall": "npm i -g pnpm",
    "clean": "rm -rf */**/{node_modules,dist,*.tsbuildinfo} && rm -rf node_modules && pnpm install",
    "start": "pnpm -r start",
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "firebase-tools": "^13.29.1",
    "husky": "9.1.5",
    "lint-staged": "^15.2.10",
    "pnpm": "^10.2.0",
    "prettier": "^3.4.2",
    "typescript": "5.3.3"
  }
}
