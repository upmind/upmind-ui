{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig/vue-library.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@upmind-automation/types": ["./packages/types/src/index.ts"],
      "@upmind-automation/i18n": ["./packages/i18n/src/index.ts"],
      "@upmind-automation/headless": ["./packages/headless/src/index.ts"],
      "@upmind-automation/upmind-ui": ["./packages/ui/src/index.ts"],
      "@upmind-automation/client-vue": ["./packages/client-vue/src/index.ts"]
    }
  },
  "include": [],
  "references": [
    { "path": "./packages/types/tsconfig.build.json" },
    { "path": "./packages/i18n/tsconfig.build.json" },
    { "path": "./packages/headless/tsconfig.build.json" },
    { "path": "./packages/ui/tsconfig.build.json" },
    { "path": "./packages/client-vue/tsconfig.build.json" }
  ]
}
