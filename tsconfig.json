{
  "files": [],
  "compilerOptions": {
    "incremental": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "moduleResolution": "Node",
    "module": "esnext",
    "target": "ES2018",
    "sourceMap": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true
  },
  "include": ["packages/*/src", "playground/src"],

  "references": [
    { "path": "packages/core" },
    { "path": "packages/cli" },
    { "path": "packages/web" },
    { "path": "playground/" }
  ],
  "exclude": ["node_modules", "dist", "*.d.ts"]
}
