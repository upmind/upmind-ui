    { "path": "./packages/client-vue/tsconfig.build.json" },
    { "path": "./packages/modules-foundation/tsconfig.build.json" },
    { "path": "./packages/modules-product/tsconfig.build.json" },
    { "path": "./packages/modules-recommendations/tsconfig.build.json" },
    { "path": "./packages/modules-catalogue/tsconfig.build.json" },
    { "path": "./packages/modules-domain/tsconfig.build.json" },
    { "path": "./packages/modules-auth/tsconfig.build.json" },
    { "path": "./packages/modules-client/tsconfig.build.json" },
    { "path": "./packages/modules-payment/tsconfig.build.json" },
