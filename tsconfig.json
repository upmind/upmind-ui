{
  "files": [],
  "compilerOptions": {
    "incremental": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "moduleResolution": "Node10",
    "module": "esnext",
    "target": "ES2018",
    "sourceMap": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true
  },
  "references": [
    { "path": "./packages/headless" },
    { "path": "./packages/headless-vue" },
    { "path": "./packages/types" }
  ],
  "exclude": ["node_modules", "coverage", "dist", "*.d.ts"]
}
