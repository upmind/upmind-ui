{
  // This tsconfig is for development. Allowing *.story.vue, and __test__/*.vue to have types support
  "compilerOptions": {
    "baseUrl": ".",
    "composite": false,
    "declaration": true,
    "declarationDir": "./dist",
    "declarationMap": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "outDir": "dist",
    "paths": {
      "@upmind-automation/types": ["packages/types/src/index.ts"], // Adjust paths as needed
      "@upmind-automation/headless": ["packages/headless/src/index.ts"],
      "@upmind-automation/upmind-ui": ["packages/ui/src/index.ts"],
      "@upmind-automation/client-vue": ["packages/client-vue/src/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "types": ["jsdom", "vite/client"]
  },
  "exclude": ["node_modules", "dist", "**/*.spec.*", "src/**/*.test.ts"]
}
