{
  "files": [],
  "compilerOptions": {
    "incremental": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "moduleResolution": "Node10",
    "module": "esnext",
    "target": "ES2018",
    "sourceMap": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src",
    "playground/src",
    "playground/typings/index.d.ts"
  ],

  "references": [
    { "path": "playground/" },
    { "path": "packages/flow" },
    { "path": "packages/flow-vue" },
    { "path": "packages/client" },
    { "path": "packages/upwind" }
  ],
  "exclude": ["node_modules", "dist", "*.d.ts"]
}
