 // none offers no editor control at all rather than one that opens nothing.
 const handoffs = computed<Record<string, ResolvedHandoff>>(() =>
-  scenario.useMutate
-    ? mapValues(scenario.handoff ?? {}, handoff => ({
-        ...handoff,
