# selector-context-scope.must-fail.patch
#
# Targets: FE-3034 AC "Labs catalogue selector (driveable)" — the scope bar's
# context segment offers `invoice` / `contract_request` as selectable catalogue
# contexts, sourced from the runtime `scopeMatrix`, and a hand switches
# catalogue by pressing one. This is the capability that replaces the deleted
# edition picker; without it FE-3034's headless axis is unreachable from the
# playground however well the loader beneath it works.
#
# Authored by: developer seat (agent-seat-separation.companion.md — the seat
# that knows the exact line it changed authors the mutant; the prover applies
# it blind, confirms RED, then reverts — never reading src to construct it).
#
# Mutates: ActingForSegment.vue `selectorMembers` — reads the registered
# matrix's RETARGET members instead of its SELECTOR members, so a cell of pure
# catalogues renders no pickable row at all. The picker still mounts and the
# panel still opens, so the failure is the missing capability rather than a
# component that no longer renders.
#
# Expected RED: selector-context-scope.spec.ts —
#   - "@AC-6 offers every catalogue the module declares, not just the first"
#   - "@AC-6 scopes the page to the catalogue the operator picks"
#   - "@AC-6 scopes the page to the catalogue at self, with no actor segment"
#   - "@AC-6 never asks the operator for an entity id"
# The retarget control ("asks for an entity id on the retarget path the same
# picker still serves") stays GREEN, which is what proves the picker itself is
# alive under the mutant.
#
# Apply / verify / revert:
#   git apply <this file>
#   pnpm --filter labs-nuxt vitest run selector-context-scope   # must go RED
#   git apply -R <this file>
#
diff --git a/playgrounds/labs-nuxt/app/components/scope/ActingForSegment.vue b/playgrounds/labs-nuxt/app/components/scope/ActingForSegment.vue
index f1aa4fa8e..1a7ec81a2 100644
--- a/playgrounds/labs-nuxt/app/components/scope/ActingForSegment.vue
+++ b/playgrounds/labs-nuxt/app/components/scope/ActingForSegment.vue
@@ -280,7 +280,7 @@ const members = computed<AvailableContext[]>(() =>
 const hasMembers = computed(() => !isEmpty(members.value));

 const selectorMembers = computed<AvailableContext[]>(() =>
-  filter(members.value, { pattern: ScopeContextPatterns.SELECTOR })
+  filter(members.value, { pattern: ScopeContextPatterns.RETARGET })
 );

