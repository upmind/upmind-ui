   function logoutSession(actor: AccessRoleTypes, sessionId: string) {
-    if (get(getTokenFromStorage(actor), "actor_id") === sessionId)
+    if (get(getTokenFromStorage(actor), "actor_id") !== sessionId)
       logout(actor);
