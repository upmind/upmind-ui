{
  "name": "@upmind-automation/labs-nuxt",
  "private": true,
  "version": "0.0.1",
  "description": "Nuxt-based playground for the Upmind platform",
  "keywords": [
    "Upmind",
    "billing",
    "sales",
    "automation",
    "platform",
    "service business",
    "shopping cart",
    "e-commerce"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>",
    "Rhodri Jones <rhodri.jones@upmind.com>"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist .nuxt .output node_modules/.cache node_modules/.vite *.tsbuildinfo",
    "start": "pnpm dev",
    "dev": "nuxt dev --host labs.localhost --dotenv .env.development",
    "build:prod": "pnpm type-check && pnpm build-only",
    "build-only": "nuxt generate",
    "type-check": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "lint": "node ../../.claude/scripts/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../.claude/scripts/lint/eslint-workspace.mjs --fix",
    "test": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "format": "prettier --write .",
    "localazy": "localazy download && pnpm format",
    "deploy": "pnpm build:prod && firebase deploy --only hosting:cart"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@nuxtjs/seo": "^3.3.0",
    "@nuxtjs/web-vitals": "^0.2.7",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/vue-query": "^5.83.1",
    "@tanstack/vue-table": "^8.21.3",
    "@upmind-automation/client-vue": "workspace:*",
    "@upmind-automation/headless": "workspace:*",
    "@upmind-automation/i18n": "workspace:*",
    "@upmind-automation/scenario-harness": "workspace:*",
    "@upmind-automation/types": "workspace:*",
    "@upmind-automation/upmind-ui": "workspace:*",
    "@vueuse/components": "^13.6.0",
    "@vueuse/core": "^13.6.0",
    "@vueuse/nuxt": "^13.6.0",
    "class-variance-authority": "^0.7.1",
    "lodash-es": "^4.17.21",
    "nuxt": "^4.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@localazy/cli": "^2.0.8",
    "@nuxt/eslint": "^1.5.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tsconfig/node22": "^22.0.2",
    "@types/google.maps": "^3.58.1",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/mercadopago-sdk-js": "^2.0.17",
    "@types/node": "^22.17.1",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
