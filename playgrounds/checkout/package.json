{
  "name": "@upmind/checkout",
  "private": true,
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite build && vite preview",
    "test": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "localazy": "localazy upload",
    "localazy:download": "localazy download",
    "localazy:sync": "localazy upload && localazy download",
    "deploy": "npm run build-only && firebase deploy --only hosting:staging",
    "deploy:prod": "npm run build-only && firebase deploy --only hosting:production"
  },
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "@floating-ui/vue": "^1.0.6",
    "@gtm-support/vue-gtm": "^3.0.1",
    "@jsonforms/core": "^3.2.1",
    "@jsonforms/vue": "^3.2.1",
    "@jsonforms/vue-vanilla": "^3.2.1",
    "@sentry/vite-plugin": "^2.21.1",
    "@sentry/vue": "^8.17.0",
    "@upmind/client-vue": "^0.0.0",
    "@vueuse/components": "^10.7.2",
    "@vueuse/core": "^10.7.2",
    "lodash-es": "^4.17.21",
    "vue": "^3.3.4",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@localazy/cli": "^1.7.10",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tailwindcss/typography": "^0.5.10",
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.2",
    "@types/lodash-es": "^4.17.9",
    "@types/node": "^18.17.15",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "autoprefixer": "^10",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^22.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
