{
  "name": "@upmind-automation/labs",
  "private": true,
  "version": "1.0.0",
  "description": "Vue.js playground for the Upmind platform",
  "keywords": [
    "Upmind"
  ],
  "authors": [
    "Dom da Costa <dominic.dacosta@upmind.com>",
    "Rhodri Jones <rhodri.jones@upmind.com>",
    "Rafael Macedo <rafael.macedo@upmind.com>"
