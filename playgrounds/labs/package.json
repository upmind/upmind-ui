  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "reset": "rm -rf {node_modules,dist,*.tsbuildinfo}",
    "start": "pnpm dev",
    "build:prod": "pnpm type-check && pnpm build-only",
    "build-only": "vite build",
    "dev": "vite",
    "type-check": "vue-tsc -p tsconfig.build.json --noEmit",
    "preview": "vite preview",
    "lint": "node ../../.claude/scripts/lint/eslint-workspace.mjs",
    "lint:fix": "node ../../.claude/scripts/lint/eslint-workspace.mjs --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@sentry/vue": "^10.4.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/vue-query": "^5.83.1",
    "@upmind-automation/types": "workspace:*",
    "@upmind-automation/headless": "workspace:*",
    "@upmind-automation/client-vue": "workspace:*",
    "@upmind-automation/upmind-ui": "workspace:*",
    "@upmind-automation/i18n": "workspace:*",
    "@vueuse/components": "^13.6.0",
    "@vueuse/core": "^13.6.0",
    "class-variance-authority": "^0.7.1",
    "lodash-es": "^4.17.21",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@localazy/cli": "^2.0.8",
    "@playwright/test": "^1.54.2",
    "@sentry/vite-plugin": "^4.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.17.1",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5",
